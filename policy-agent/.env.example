# App
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=

# Database
DATABASE_URL=
POLICY_AGENT_DB_PATH=data/uavguard_policy_agent.sqlite3

# Auth
AUTH_TOKEN_TTL_HOURS=24
AUTH_PASSWORD_MIN_LENGTH=10

# Knowledge Agent
KNOWLEDGE_AGENT_MODE=mock
KNOWLEDGE_AGENT_BASE_URL=
KNOWLEDGE_AGENT_TIMEOUT_SECONDS=15
KNOWLEDGE_AGENT_MAX_RETRIES=1

# LLM
# For more ChatGPT-like grounded replies, set an OpenAI-compatible endpoint such as
# LLM_BASE_URL=https://api.openai.com/v1 and provide LLM_API_KEY.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# Policy and simulator
POLICY_STORE_PATH=
POLICY_VERSION=2026.07-part107-baseline
SIMULATOR_BASE_URL=

# Retrieval
UAVGUARD_VECTOR_BACKEND=json
UAVGUARD_TOP_K=5

# Optional paths
DATA_DIR=
UPLOADS_DIR=
TEMP_DIR=
